# Orca — Kraken API credentials (OPTIONAL; not needed for paper backtest)
# Create keys at: https://www.kraken.com/u/security/api
# NEVER commit real keys. Prefer Query-only first (no Trade / no Withdraw).
#
# Recommended first key (monitoring only):
#   Permissions: Query Funds, Query Open Orders & Trades, Query Closed Orders & Trades
#   Do NOT enable: Create & Modify Orders, Cancel/Close Orders, Withdraw Funds
#
# Later (live trading — requires separate explicit approval):
#   Add Create & Modify Orders + Cancel/Close Orders only if you intentionally go live.
#   Keep Withdraw Funds OFF always for a trading bot key.
#   Use IP whitelist when possible.

KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Mode: paper | live  (live is disabled in code until you explicitly enable it)
ORCA_MODE=paper
